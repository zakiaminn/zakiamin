// Cloudflare Workers config: serves the built site in dist/ as static files.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` on every push to main
// and `npx wrangler preview` on every other branch.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "zakiamin",
  "compatibility_date": "2026-11-25",
  // Adds byte-range support for the demo videos, which Safari needs to play them.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every other file is served without running the Worker.
    "run_worker_first": ["/*.mp4"],
    // /batin serves dist/batin/index.html and redirects to /batin/.
    "html_handling": "auto-trailing-slash",
    // A path that matches no file gets dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Pull requests and other branches get a preview URL from `npx wrangler preview`,
  // which needs this block even when it's empty.
  "previews": {}
}
