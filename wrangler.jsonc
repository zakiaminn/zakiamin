// Cloudflare Workers config: serves the built site in dist/ as static files.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` on every push to main
// and `npx wrangler preview` on every other branch.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "zakiamin",
  "compatibility_date": "2026-11-25",
  // Adds byte-range support for the demo videos, which Safari needs to play them.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every other file is served without running the Worker. /admin/api/* is
    // the analytics data behind the private page at /admin/.
    "run_worker_first": ["/*.mp4", "/admin/api/*"],
    // /batin serves dist/batin/index.html and redirects to /batin/.
    "html_handling": "auto-trailing-slash",
    // A path that matches no file gets dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  // Settings for /admin/api/*. None of these is secret. The PostHog personal
  // API key is the POSTHOG_PERSONAL_API_KEY secret, set in the Cloudflare
  // dashboard (Workers > zakiamin > Settings > Variables and Secrets).
  // Previews don't inherit these, which is deliberate: there the admin API
  // refuses every request.
  "vars": {
    // PostHog's private API host (us.posthog.com or eu.posthog.com, not the
    // .i. ingestion host) and the project the site reports to.
    "POSTHOG_API_HOST": "https://us.posthog.com",
    "POSTHOG_PROJECT_ID": "579518",
    // The Cloudflare Access team domain and the Application Audience (AUD) tag
    // of the "zakiamin.com admin" application (www.zakiamin.com/admin and
    // /admin/*). Until both are set, the admin API refuses every request.
    "ACCESS_TEAM_DOMAIN": "https://crimson-glitter-737c.cloudflareaccess.com",
    "ACCESS_AUD": "2c81c8ca03804aa3d2fd075c7bdd3bf17196c6d0f73ba10ce48f4412c0ca5aff"
  },
  // Pull requests and other branches get a preview URL from `npx wrangler preview`,
  // which needs this block even when it's empty.
  "previews": {}
}
